# syntax=docker/dockerfile:1

# ---------- build ----------
# Every route is prerendered to static HTML, so Node only produces files;
# nothing runs at serve time.
FROM node:22.23-alpine AS builder
WORKDIR /app

# Install from the lockfile first so this layer is cached until it changes.
COPY package.json package-lock.json ./
RUN npm ci --no-fund --no-audit

COPY . .

# The container serves the site at the domain root, so BASE_PATH stays empty
# (only the GitHub Pages project site needs a sub-path). SITE_URL sets the
# canonical URLs, sitemap and robots.txt for wherever this image is hosted.
# The EmailJS values are public-by-design identifiers inlined into the
# bundle; leave them empty and the forms fall back to a mailto link.
ARG BASE_PATH=""
ARG SITE_URL=""
ARG VITE_EMAILJS_SERVICE_ID=""
ARG VITE_EMAILJS_TEMPLATE_ID=""
ARG VITE_EMAILJS_PUBLIC_KEY=""
ENV BASE_PATH=$BASE_PATH \
    SITE_URL=$SITE_URL \
    VITE_EMAILJS_SERVICE_ID=$VITE_EMAILJS_SERVICE_ID \
    VITE_EMAILJS_TEMPLATE_ID=$VITE_EMAILJS_TEMPLATE_ID \
    VITE_EMAILJS_PUBLIC_KEY=$VITE_EMAILJS_PUBLIC_KEY

RUN npm run build && npm run check:links

# ---------- serve ----------
# Unprivileged nginx runs as uid 101 and listens on 8080, so the container
# needs no root user and no capabilities.
FROM nginxinc/nginx-unprivileged:1.30-alpine AS runner

COPY --chown=nginx:nginx nginx.conf /etc/nginx/conf.d/default.conf
# Per-page Content-Security-Policy map generated by scripts/postbuild.mjs.
COPY --from=builder --chown=nginx:nginx /app/build/nginx-csp-map.conf /etc/nginx/conf.d/00-csp-map.conf
COPY --from=builder --chown=nginx:nginx /app/build/client /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1

# The base image already sets a non-root USER and the nginx entrypoint.
