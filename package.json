{
  "name": "iriic-website",
  "version": "1.0.0",
  "private": true,
  "description": "IRIIC, United International University. Fully prerendered React Router + Tailwind build.",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "node scripts/run-ts.mjs scripts/validate-data.ts && react-router build && node scripts/postbuild.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "validate": "node scripts/run-ts.mjs scripts/validate-data.ts",
    "check:links": "node scripts/check-links.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-router/node": "^7.18.5",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^7.18.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
