# No secrets are needed to build this site. Copy to .env only for local
# overrides; .env is git-ignored.
#
# BASE_PATH is set by CI to "/<repository-name>" for GitHub Pages. Leave it
# empty to build for a domain root (Docker, local preview).
# BASE_PATH=/IRRIC_Website
#
# SITE_URL is the canonical origin plus base path. Defaults to the GitHub
# Pages URL. Set it for a custom domain or the Docker deployment.
# SITE_URL=https://iriic.example.org
#
# EmailJS identifiers for the contact form. They are public by design: the
# browser needs them to call EmailJS and they grant no account access. If
# any is blank, the site shows an email link instead of the form.
# VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
#
# Override the date used to decide which vacancies are open (YYYY-MM-DD).
# BUILD_DATE=2026-10-29
